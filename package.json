{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "description": "DevFlow application scaffold",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:smoke": "tsx scripts/db-smoke.ts"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
