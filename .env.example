DATABASE_URL=postgres://devflow:devflow@localhost:5432/devflow

# Origin of this Next.js process. Local dev and start listen on 127.0.0.1:3000.
BETTER_AUTH_URL=http://127.0.0.1:3000

# At least 32 random characters. Example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth App. The callback URL must be exactly:
# http://127.0.0.1:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated numeric GitHub user ids. Login names are not accepted.
# Empty, missing, or malformed values deny every account.
# A change is read when the process starts. Restart or redeploy to apply it.
PILOT_GITHUB_USER_IDS=
